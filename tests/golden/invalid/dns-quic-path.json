{
  "log": {
    "level": "info"
  },
  "dns": {
    "servers": [
      {
        "type": "quic",
        "tag": "doq",
        "server": "dns.adguard-dns.com",
        "path": "/dns-query"
      },
      {
        "type": "udp",
        "tag": "upstream",
        "server": "1.1.1.1"
      }
    ],
    "final": "doq"
  },
  "outbounds": [
    {
      "type": "direct",
      "tag": "direct"
    }
  ],
  "route": {
    "final": "direct",
    "default_domain_resolver": "upstream"
  }
}
