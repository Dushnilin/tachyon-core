#!/bin/sh /etc/rc.common
# Copyright (C) 2026 tachyon-core developers

START=95
STOP=10
USE_PROCD=1

NAME="tachyon-core"
PROG="/usr/bin/tachyon-core"
[ -x "$PROG" ] || PROG="/usr/bin/sing-box"

DEFAULT_CONF="/etc/tachyon-core/config.json"
FALLBACK_CONF="/etc/sing-box/config.json"
RUN_CONF="/tmp/sing-box/config.json"

get_config_path() {
	if [ -f /sbin/uci ]; then
		local uci_conf
		uci_conf="$(uci -q get tachyon-core.main.config_file)"
		if [ -n "$uci_conf" ] && [ -e "$uci_conf" ]; then
			echo "$uci_conf"
			return
		fi
	fi
	if [ -f "$RUN_CONF" ]; then
		echo "$RUN_CONF"
		return
	fi
	if [ -f "$FALLBACK_CONF" ]; then
		echo "$FALLBACK_CONF"
		return
	fi
	echo "$DEFAULT_CONF"
}

start_service() {
	[ -x "$PROG" ] || {
		logger -t "$NAME" "binary $PROG not found or not executable"
		return 1
	}

	local conf
	conf="$(get_config_path)"
	if [ ! -f "$conf" ] && [ ! -d "$conf" ]; then
		logger -t "$NAME" "config path '$conf' does not exist"
		return 1
	fi

	# Pre-flight check: validate config syntax before starting procd instance
	# Prevents endless respawn crash-loops if an invalid config was written
	if ! "$PROG" check -c "$conf" >/dev/null 2>&1; then
		logger -t "$NAME" "pre-flight check failed for '$conf', refusing to start"
		"$PROG" check -c "$conf" 2>&1 | logger -t "$NAME"
		return 1
	fi

	# Determine worker thread count: 1 on single-core / low-RAM routers
	local cpus
	cpus="$(grep -c '^processor' /proc/cpuinfo 2>/dev/null || echo 1)"
	[ "$cpus" -lt 1 ] && cpus=1

	procd_open_instance "$NAME"
	procd_set_param command "$PROG" run -c "$conf"
	procd_set_param respawn 3600 5 5
	procd_set_param file "$conf"

	# High file-descriptor limit prevents EMFILE under heavy routing load
	procd_set_param limits nofile="65535 65535"

	# Soft start allows daemon to bind and serve local DNS even if WAN is not up yet
	procd_set_param env TACHYON_RULESET_SOFT_START=1
	procd_set_param env TACHYON_WORKERS="$cpus"

	# Shield the proxy daemon from aggressive OOM killer sweeps on low-RAM devices
	procd_set_param oom_score_adj -500

	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance

	logger -t "$NAME" "service started with config: $conf"
}

check() {
	local conf
	conf="$(get_config_path)"
	echo "Validating configuration with $PROG: $conf"
	"$PROG" check -c "$conf"
}

version() {
	"$PROG" version
}

service_triggers() {
	procd_add_reload_trigger "tachyon-core"
}

EXTRA_COMMANDS="check version"
EXTRA_HELP="        check   Validate configuration file
        version Show core version and build info"
